# Copy to .env and edit. Never commit .env.
DJANGO_DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173
# Leave empty to use SQLite. For PostgreSQL: postgres://user:password@host:5432/dbname
DATABASE_URL=
